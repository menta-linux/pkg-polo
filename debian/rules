#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	dh_auto_configure -- --buildtype=release -Dtests=false

# libweston is Polo's private copy in /usr/lib/<triplet>/polo: no shlibs/symbols
override_dh_makeshlibs:
	dh_makeshlibs -n

override_dh_shlibdeps:
	dh_shlibdeps -l/usr/lib/$(DEB_HOST_MULTIARCH)/polo

# headers, pkg-config files and protocol XML of the private libweston are not shipped
execute_after_dh_auto_install:
	rm -rf debian/polo/usr/lib/*/polo/include debian/polo/usr/lib/*/polo/pkgconfig \
	       debian/polo/usr/lib/*/polo/share debian/polo/usr/lib/*/polo/libweston-16.so
